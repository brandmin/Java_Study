package operator.ex;

public class Oper_AI_Test1 {
    public static void main(String[] args) {
        int maxMemory = 16000; // 최대 메모리 용량 16000GB
        int usedMemory = 13000; // 사용중인 메모리 용량 13000GB
        int errorLogCount = 4; // 에러 로그 발생 횟수

        ++errorLogCount;
        int memoryUsage = ((usedMemory * 100) / maxMemory); // 현재 메모리 사용률(%)
        boolean isAlert = memoryUsage >= 80 && errorLogCount >= 5;

        System.out.println("최종적으로 isAlert 값은 " + isAlert + " 입니다.");
    }
}

### 풀이 핵심
최대 메모리 용량과 사용중인 메모리 용량, 에러 로그 발생 횟수를 정수형 타입으로 선언하고 임의의 값으로 초기화한다.
에러 로그가 발생했을 때 errorLogCount 변수를 1씩 증가시키고 maxMemory, usedMemory 변수를 이용해서 현재 메모리 사용률인 memoryUsage를 구한다.
그런 후 memoryUsage가 80% 이상이고 errorLogCount 값이 5일 경우 경고가 표시되도록 한다.
사용된 문법은 변수 선언, 변수 초기화, 변수 할당, 산술 연산자, 우선 순위 연산자, 논리 연산자, 증감 연산자

### 개선될 점
콘솔에 출력될 출력문을 개선하기
  
[before]
System.out.println("최종적으로 isAlert 값은 " + isAlert + " 입니다.");
[after]
System.out.println("[시스템 상태] 현재 메모리 사용률: " + memoryUsage + "%");
System.out.println("[시스템 상태] 누적 에러 로그: " + errorLogCount + "건");
System.out.println("----------------------------------------");
System.out.println("최종 관리자 알람 발생 여부(isAlert) : " + isAlert);
