package operator.ex;

public class Oper_AI_Test2 {
    public static void main(String[] args) {
        int cardBalance = 10000; // K-패스 카드 잔액
        int transferMinutes = 25; // 환승까지 걸린 시간
        boolean isSubway = true; // 탑승할 수단이 지하철인지 여부
        int transferCount = 3; // 남은 환승 가능 횟수

        boolean isDiscount = transferMinutes <= 30 && isSubway == true;
        if !isDiscount {
            cardBalance -= 1500;
        }

        --transferCount;
        System.out.println("최종 카드 잔액은 " + cardBalance + "원 입니다.");
        System.out.println("남은 환승 횟수는 " + transferCount + "회 입니다.");

    }
}

### 풀이 핵심
cardBalance, transferMinutes 변수를 정수형 타입으로 선언한 후 값을 할당한다.
isSubway 변수를 탑승할 수단이 지하철인지 여부를 말하며 boolean 타입으로 지정한다.
transferMinutes가 30분 이하이고 교통수단이 지하철이라면 isDiscount 값을 true로 지정된다.

만약, isDiscount 변수 즉, 할인되지 않는다면 카드 잔액에 1500원을 차감한다. 그리고 환승 가능 횟수를 1을 차감한다.

